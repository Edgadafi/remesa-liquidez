{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx --yes esbuild src/app.ts --bundle --platform=node --format=esm --outfile=src/app.js --packages=external",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{src/app.js,node_modules/{zod,@x402,@stellar,express,nirium,prova-agent-sdk,@solana,@lifi,dotenv}/**}"
    }
  }
}
