{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx --yes esbuild api/index.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external && rm -f api/index.ts",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/{zod,@x402,@stellar,express,nirium,prova-agent-sdk,@solana,@lifi,dotenv}/**"
    }
  }
}
