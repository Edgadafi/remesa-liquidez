# ═══════════════════════════════════════════════════════════════════════════
#  Remesa LiquidezIA — Variables de entorno unificadas del monorepo
#
#  Uso:
#    cp .env.example .env          → llena los valores reales
#    npm run sync-env              → propaga a web/.env y backend/.env
#
#  Reglas de seguridad:
#    - Nunca commitear .env (está en .gitignore)
#    - Las vars NEXT_PUBLIC_* son expuestas al browser — solo datos públicos
#    - ELEVENLABS_API_KEY, KEEPER_PRIVATE_KEY, RENDER_INTERNAL_SECRET → server-side only
# ═══════════════════════════════════════════════════════════════════════════

# ── Solana / Red ───────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
# RPC privado recomendado en producción (Helius, QuickNode, Triton)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Expuesto al browser (wallet-adapter, MWA connection)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ── Programa Anchor ────────────────────────────────────────────────────────
# Program ID del contrato remesa_liquidez en devnet
NEXT_PUBLIC_PROGRAM_ID=Fprb6jTLfjXfZ6yuWzS7LVXxwVvPbPgPZiEqDEL9bRfj

# ── SPL Tokens ─────────────────────────────────────────────────────────────
# USDC devnet: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# USDC mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ── Frontend (Vercel) ──────────────────────────────────────────────────────
# URL canónica — usada en metadataBase, OG tags y MWA appIdentity
NEXT_PUBLIC_SITE_URL=https://web-coral-pi-66.vercel.app
NEXT_PUBLIC_BLINK_BASE_URL=https://web-coral-pi-66.vercel.app
# Iconos por Action (opcional — usa Unsplash defaults si se omite)
NEXT_PUBLIC_BLINK_ICON_URL=
NEXT_PUBLIC_VERIFY_ICON_URL=

# ── Backend TIA (proyecto Vercel `web` / web-coral-pi-66) ───────────────────
# Vive en el frontend, no en remesa-tia-backend.
RENDER_BACKEND_URL=https://remesa-tia-backend.vercel.app
# Bot WhatsApp Baileys — URL pública HTTPS (Render o túnel). Nunca localhost:
# las Functions de Vercel no alcanzan tu WSL; secret sin URL pública = 502.
BOT_INTERNAL_URL=https://remesa-blink-bot.onrender.com
BOT_INTERNAL_SECRET=
# Si true, /api/tia/notify responde 200 aunque el bot esté offline (solo demo local)
TIA_ALLOW_NOTIFY_WITHOUT_BOT=false
# Manual override cuando webhooks fallan en test en vivo (Do Things That Don't Scale)
TIA_MANUAL_OVERRIDE_SECRET=
# Comercio piloto hardcoded si falla routing de tiendas (demo-merchant-1 devnet)
NEXT_PUBLIC_FALLBACK_MERCHANT_PUBKEY=9973FHqsvU5govuEiWgFmjcU6bbMNPTQceGEjrpkiV9i
# URL para Blink links en WhatsApp (backend TIA)
BLINK_BASE_URL=https://web-coral-pi-66.vercel.app

# Ruta notify TIA en Render (opcional; default: /api/tia/notify con fallback /api/lidia/notify)
# TIA_NOTIFY_PATH=/api/tia/notify

# ── ElevenLabs TTS ────────────────────────────────────────────────────────
# API key server-side — NUNCA anteponer NEXT_PUBLIC_
ELEVENLABS_API_KEY=
# Voz de TIA: Sarah ES (femenina, cálida)
#   EXAVITQu4vr4xnSDxMaL → Sarah  (default)
#   onwK4e9ZLuTAKqWW03F9 → Daniel
#   pNInz6obpgDQGcFmaJgB → Adam
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Keeper / Scripts devnet ────────────────────────────────────────────────
# Keypair JSON del sender authority para scripts E2E y Keeper bot
# Generar: solana-keygen new --outfile ~/.config/solana/keeper.json
KEEPER_PRIVATE_KEY=
# Receptor de demo para tests E2E
E2E_RECEIVER_PUBKEY=

# ── Stellar / Soroban (dual-chain PoC — optional) ───────────────────────────
# Default chain for new senders: solana | stellar
NEXT_PUBLIC_DEFAULT_CHAIN=solana
# Enable Stellar in sender UI (beta slots)
NEXT_PUBLIC_STELLAR_PILOT_ENABLED=false
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Mainnet escrow (14 sep 2026). Never put Freighter S… on Vercel.
STELLAR_CONTRACT_ID=CBCWBOZBCKJ4FSCMQ2OJUI3UDDNT7QSPURTSAELKESPY6D7DUA22M5MP
NEXT_PUBLIC_STELLAR_CONTRACT_ID=CBCWBOZBCKJ4FSCMQ2OJUI3UDDNT7QSPURTSAELKESPY6D7DUA22M5MP

# ── Accesly (Stellar social wallet — @accesly/react) ────────────────────────
# Register app at https://dev.accesly.xyz → enable Google OAuth
# Redirect URIs: {NEXT_PUBLIC_SITE_URL}/auth/callback and http://localhost:3000/auth/callback
NEXT_PUBLIC_ACCESLY_APP_ID=
NEXT_PUBLIC_ACCESLY_ENV=dev

# ── Prova (behavior attestation — devnet) ───────────────────────────────────
PROVA_ENABLED=false
PROVA_RPC_URL=https://api.devnet.solana.com
# Keypair JSON del agente TIA (dedicado; generado por register-prova-agent.ts)
PROVA_AGENT_SECRET_KEY=
# Operator que registra/attesta (default: reutiliza KEEPER_PRIVATE_KEY)
PROVA_OPERATOR_SECRET_KEY=
# PDA pública del agente — para /status y pitch
NEXT_PUBLIC_PROVA_AGENT_PDA=

# ── Nirium x402 (premium API — backend TIA en Vercel) ────────────────────────
# Facilitator testnet: https://channels.openzeppelin.com/testnet/gen
# Mainnet: payTo G… de pubnet con trustline USDC (~1.5 XLM) + key de
# https://channels.openzeppelin.com/gen (no la de /testnet/gen).
NIRIUM_X402_ENABLED=false
STELLAR_PAY_TO=
X402_FACILITATOR_API_KEY=
STELLAR_NETWORK=testnet
# Origen canónico (scheme+host) del resource.url en el 402 — TLS termina en
# Vercel, así que sin esto el header payment-required anuncia http://.
# Setear también en Production del proyecto Vercel remesa-tia-backend.
PUBLIC_BASE_URL=https://remesa-tia-backend.vercel.app
NIRIUM_X402_BRIDGE_PRICE=0.25
NIRIUM_X402_FX_PRICE=0.10
# Solo local — scripts/x402-smoke.ts. NUNCA subir a Vercel (firma pagos).
STELLAR_TESTNET_SECRET=

# ── World ID (futuro) ──────────────────────────────────────────────────────
WORLD_ID_APP_ID=
WORLD_ID_ACTION=verify-remesa
