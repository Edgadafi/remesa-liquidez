# Stellar mainnet secret key (S...) of the paying account.
# Needs: USDC trustline + a few cents of USDC. Fees are facilitator-sponsored.
# NEVER commit the real value. This file only documents the variable names.
STELLAR_SECRET=

# REQUIRED to pay: allowlist of recipient accounts (comma-separated G...).
# Run `npm run dry-run` to see the payTo the server announces, verify it
# out-of-band (e.g. against /status or the repo docs), then pin it here.
# The client refuses to sign a payment to any account not on this list.
EXPECTED_PAY_TO=

# Per-payment spend cap in USD (default 0.50). Terms above this are rejected
# by the SDK's spend controls before anything is signed.
MAX_PRICE_USDC=0.50

# Optional overrides
TIA_API_BASE=https://remesa-tia-backend.vercel.app
# /v1/quote ($0.10) | /v1/route?amount=100 ($0.25) | /premium/fx ($0.10)
TIA_TARGET_PATH=/v1/quote
# stellar:pubnet (default) | stellar:testnet — the scheme is registered ONLY
# for this network, so terms on any other network are never paid.
STELLAR_NETWORK=stellar:pubnet
# Soroban RPC override (defaults: gateway.fm pubnet / SDF testnet)
STELLAR_RPC_URL=
